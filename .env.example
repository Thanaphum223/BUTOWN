# Copy to .env and generate unique random secrets. Never commit .env.
DB_ADMIN_PASSWORD=
DB_PASSWORD=
BOOTSTRAP_PASSWORD=
# Optional LINE integration. Login and Messaging API must use the same provider.
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
LINE_MUNICIPALITY_ID=
LINE_CHANNEL_ACCESS_TOKEN=

# Optional approved/self-hosted Nominatim-compatible endpoint; no public default.
GEOCODING_BASE_URL=

# GOV SRS integrations. Use secret management in production.
# pk.* public, URL-restricted Mapbox token only; never use sk.* here.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_GEOCODING_TOKEN=
GOV_AUTH_MODE=local
GOV_INTROSPECTION_URL=
GOV_CLIENT_ID=
GOV_CLIENT_SECRET=
GOV_AUDIENCE=towntrack
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRIVACY_NOTICE_VERSION=local-test-v1
PRIVACY_NOTICE_TEXT=
