# Copy to .env and generate unique random secrets. Never commit .env.
DB_ADMIN_PASSWORD=
DB_PASSWORD=
BOOTSTRAP_PASSWORD=
# Optional LINE integration. Login and Messaging API must use the same provider.
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
LINE_MUNICIPALITY_ID=
LINE_CHANNEL_ACCESS_TOKEN=

# Optional approved/self-hosted Nominatim-compatible endpoint; no public default.
GEOCODING_BASE_URL=

# GOV SRS integrations. Use secret management in production.
# pk.* public, URL-restricted Mapbox token only; never use sk.* here.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_GEOCODING_TOKEN=
# Gov Center uses ONE secret API key. Service Code is a public service identifier.
# Keep local until callback registration and account linking are verified.
GOV_AUTH_MODE=local
IAM_API_URL=https://api-auth.govcenter.co
IAM_GOV_FRONTEND_URL=https://auth.govcenter.co
E_SERVICE_CODE=
E_SERVICE_API_KEY=
GOV_CALLBACK_URL=
GOV_MUNICIPALITY_ID=
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
PRIVACY_NOTICE_VERSION=local-test-v1
PRIVACY_NOTICE_TEXT=
