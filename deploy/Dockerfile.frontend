FROM --platform=$BUILDPLATFORM node:24-alpine AS build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_ENABLE_UAT_TOOLS=false
ENV VITE_ENABLE_UAT_TOOLS=$VITE_ENABLE_UAT_TOOLS
RUN npm run build
FROM nginx:stable-alpine
COPY --chmod=755 deploy/40-trusted-proxy.sh /docker-entrypoint.d/40-trusted-proxy.sh
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
