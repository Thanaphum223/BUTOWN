# Copy to /opt/towntrack/.env, mode 0600. Generate unique values on the server.
SITE_ADDRESS=towntrack.example.com
DB_ADMIN_PASSWORD=replace-with-random-value
DB_PASSWORD=replace-with-another-random-value
BOOTSTRAP_PASSWORD=replace-with-random-password-at-least-16-characters
# Gov Center uses ONE secret API key. Service Code is a public service identifier.
# Keep local until callback registration and account linking are verified.
E_SERVICE_CODE=
E_SERVICE_API_KEY=
GOV_CALLBACK_URL=
# Optional: Gov's own ID for this municipality (not a secret). When set, administrators cannot change it.
GOV_CENTER_MUNICIPALITY_ID=
STORAGE_PROVIDER=local
PRIVACY_NOTICE_VERSION=cloud-test-v1
